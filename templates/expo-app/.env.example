# Copy to .env and fill in before building. Every value here is a *public*
# client key; a service-role or admin secret must never appear in this file.

# Supabase - project URL and anon (publishable) key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat - public SDK keys, one per platform.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog - project API key and host.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry - DSN is public by design.
EXPO_PUBLIC_SENTRY_DSN=

# Every integration above is optional. With a value missing, that integration
# runs in no-op mode so the app still builds, boots and tests green.
